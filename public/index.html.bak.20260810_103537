<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Kimiko Webook Booking Assistant</title>
  <link rel="stylesheet" href="style.css" />
  <script src="/socket.io/socket.io.js"></script>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header>
      <h1>🎫 Kimiko Webook Booking Assistant</h1>
      <p class="subtitle">حجز آلي لمقاعد webook.com</p>
    </header>

    <!-- Status Dashboard -->
    <section class="card dashboard">
      <div class="dashboard-main">
        <div class="status-pill">
          <span id="statusBadge" class="badge idle">Idle</span>
        </div>
        <div class="stats-grid">
          <div class="stat-box">
            <span class="stat-value" id="activeCount">0</span>
            <span class="stat-label">نشط</span>
          </div>
          <div class="stat-box">
            <span class="stat-value" id="pendingCount">0</span>
            <span class="stat-label">في الانتظار</span>
          </div>
          <div class="stat-box">
            <span class="stat-value" id="doneCount">0</span>
            <span class="stat-label">اكتمل</span>
          </div>
          <div class="stat-box success">
            <span class="stat-value" id="heldCount">0</span>
            <span class="stat-label">مقاعد ممسوكة</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content Grid -->
    <div class="grid two-col">
      <!-- Left Column -->
      <div class="col">
        <!-- Event URL Section -->
        <section class="card">
          <h2>🔗 رابط الفعالية</h2>
          <input type="text" id="eventUrl" placeholder="https://webook.com/ar/sa/jed/music-events/events/.../book"
            value="https://webook.com/ar/sa/jed/music-events/events/this-is-michael-musical-show-jeddah-tickets-2026/book" />
          <div class="row">
            <button id="fetchBtn" class="primary">🔍 جلب الأقسام</button>
            <button id="refreshAvailabilityBtn" class="secondary">🔄 تحديث</button>
            <button id="checkQueueBtn" class="secondary hidden">🚦 اختبار الطابور</button>
          </div>
          <div id="eventInfo" class="event-info hidden">
            <div class="event-info-header">
              <strong id="eventInfoTitle"></strong>
              <span id="eventQueueBadge" class="event-badge unknown hidden">غير معروف</span>
            </div>
            <div id="eventInfoBody"></div>
          </div>
        </section>

        <!-- Accounts Section -->
        <section class="card">
          <h2>👥 الحسابات</h2>

          <div class="account-inputs">
            <div class="form-row">
              <div class="form-group">
                <label>البريد الإلكتروني</label>
                <input type="email" id="manualEmail" placeholder="example@email.com" value="tariqibrahim20@hotmail.com" />
              </div>
              <div class="form-group">
                <label>كلمة المرور</label>
                <input type="password" id="manualPassword" placeholder="••••••" value="Dd112233@" />
              </div>
            </div>
            <div class="row">
              <button id="addAccountBtn" class="success">➕ إضافة حساب</button>
              <button id="addDefaultAccountBtn" class="secondary">استخدام الحساب الافتراضي</button>
            </div>
          </div>

          <div class="account-inputs holdtoken-inputs">
            <p class="hint">💡 وضع الكوكيز/التوكن بيحجز مباشرة من غير تسجيل دخول بالإيميل/الباسورد.</p>
            <div class="form-row">
              <div class="form-group wide">
                <label>Hold Token (اختياري لو هتحط كوكيز)</label>
                <input type="text" id="manualHoldToken" placeholder="d0995361-f565-4e1c-85f8-0cab9319c6f6" />
              </div>
            </div>
            <div class="form-row">
              <div class="form-group wide">
                <label>أو الصق كل الكوكيز هنا (Copy as Header / Cookies Editor)</label>
                <textarea id="manualCookies" rows="4" placeholder="queue_session=...; holdToken=...; token=...; refresh_token=...; cf_clearance=..."></textarea>
              </div>
            </div>
            <div class="row">
              <button id="addByTokenOrCookiesBtn" class="success">➕ إضافة للحجز</button>
            </div>
          </div>

          <div class="file-upload-row">
            <label>أو اختر ملف txt (سطر لكل حساب بالصيغة username:password أو hold:token:email:password)</label>
            <input type="file" id="accountsFile" accept="txt" />
          </div>

          <div class="row account-actions-bar">
            <button id="selectAllAccountsBtn" type="button">تحديد الكل</button>
            <button id="clearAccountsBtn" type="button">إلغاء الكل</button>
            <button id="removeAllAccountsBtn" type="button" class="danger-text">حذف الكل</button>
            <button id="loadAccountsBtn" type="button">📥 تحميل من الخادم</button>
            <button id="saveAccountsBtn" type="button">💾 حفظ على الخادم</button>
          </div>

          <div id="accountsList" class="accounts-list"></div>
          <div id="accountsSummary" class="summary">0 حساب محمل</div>
        </section>

        <!-- Proxy Section -->
        <section class="card">
          <h2>🌐 البروكسيات</h2>
          <p class="hint">سطر لكل بروكسي. الصيغ المدعومة: host:port | user:pass@host:port | http://user:pass@host:port | socks5://host:port | JSON</p>
          <textarea id="proxyList" rows="5" placeholder="http://user:pass@proxy.example.com:8080&#10;socks5://proxy2.example.com:1080&#10;proxy3.example.com:3128"></textarea>
          <div class="row">
            <button id="saveProxiesBtn" type="button" class="success">💾 حفظ البروكسيات</button>
            <button id="loadProxiesBtn" type="button" class="secondary">📥 تحميل البروكسيات</button>
          </div>
          <div id="proxiesSummary" class="summary">0 بروكسي محمل</div>
        </section>
      </div>

      <!-- Right Column -->
      <div class="col">
        <!-- Control Panel -->
        <section class="card control-card">
          <h2>⚙️ التحكم</h2>
          
          <label>عدد المتصفحات المتزامنة (0 = تلقائي)</label>
          <input type="number" id="maxConcurrency" value="1" min="0" max="100" />
          <div id="concurrencyHint" class="hint">سيفتح حساب واحد فقط في نفس الوقت</div>

          <div class="control-buttons">
            <button id="startBookingBtn" class="primary big">🚀 بدء الحجز</button>
            <button id="stopBookingBtn" class="danger big">⛔ إيقاف الكل</button>
          </div>

          <hr class="section-divider" />

          <div class="pair-cycling-panel">
            <h3>🔄 Pair Cycling (تناوب الحجز)</h3>
            <p class="hint">كل يوزرين يتناوبون على مسك نفس الكراسي كل 8 دقائق لمدة ساعة كحد أقصى.</p>
            <div class="control-buttons">
              <button id="startPairCyclingBtn" class="success big">🔄 بدء التناوب</button>
              <button id="stopPairCyclingBtn" class="danger big">⛔ إيقاف التناوب</button>
            </div>
            <div id="pairCyclesStatus" class="pair-cycles-status hidden"></div>
          </div>

          <div class="row">
            <button id="downloadLogsBtn" class="secondary">📥 تحميل السجل</button>
            <button id="clearLogsBtn" class="secondary">🧹 مسح السجل</button>
          </div>
        </section>

        <!-- Sections Selection -->
        <section class="card">
          <h2>📋 الأقسام المتاحة <small>(اختر قسماً واحداً أو أكثر)</small></h2>
          <div id="sectionsList" class="sections-list"></div>
          <div id="selectionHint" class="hint">اختر قسماً واحداً على الأقل ليتم تفعيل زر بدء الحجز</div>
        </section>
      </div>
    </div>

    <!-- Logs Section -->
    <section class="card">
      <h2>📊 السجل</h2>
      <div id="logs" class="logs"></div>
    </section>
  </div>

  <script src="app.js"></script>
</body>
</html>
